<?xml version="1.0" encoding="utf-8"?>
<!-- The About block: what this is and which version is running. It holds no control - the rows that
     lead somewhere are below, where a remote finds them the way it finds every other row. What the
     device can do has a screen of its own (Device info). The wash is the ground the app gives itself
     elsewhere too, so the lettering is white in either appearance. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.brouken.player.BrandWash
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <include layout="@layout/preference_about_identity" />

    </LinearLayout>

</FrameLayout>
